<Window x:Class="AnchorHoleWorkcell.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Anchor Hole Workcell" Width="1500" Height="900" Background="#0B0F14" Foreground="#EAF0F7">
  <Window.Resources>
    <Style x:Key="ActionButton" TargetType="Button"><Setter Property="Background" Value="#223248"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#40536C"/><Setter Property="Padding" Value="13,8"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
    <Style x:Key="GridHeader" TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#202A37"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="8"/></Style>
  </Window.Resources>
  <Grid Margin="14">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#151B24" CornerRadius="8" Padding="11" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal">
        <Button x:Name="LiveButton" Style="{StaticResource ActionButton}" Content="▶ LIVE START" Click="Live_Click" Background="#176B47"/>
        <ToggleButton x:Name="InspectButton" Content="◎ HOLE INSPECT" Click="Inspect_Click" Background="#253A55" Foreground="White" BorderBrush="#40536C" Padding="13,8" Margin="0,0,14,0"/>
        <TextBlock Text="Z 범위" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <ComboBox x:Name="RangeBox" Width="145" SelectedIndex="0" SelectionChanged="Range_Changed" Background="White" Foreground="Black" Margin="0,0,14,0">
          <ComboBoxItem Content="200 – 1600 mm" Tag="200,1600"/><ComboBoxItem Content="500 – 1900 mm" Tag="500,1900"/><ComboBoxItem Content="1000 – 2400 mm" Tag="1000,2400"/><ComboBoxItem Content="2000 – 3400 mm" Tag="2000,3400"/><ComboBoxItem Content="3000 – 4400 mm" Tag="3000,4400"/>
          <ComboBoxItem Content="200 - 500 mm (close)" Tag="200,500"/>
          <ComboBoxItem Content="200 - 800 mm (close)" Tag="200,800"/>
          <ComboBoxItem Content="200 - 1200 mm (close)" Tag="200,1200"/>
        </ComboBox>
        <TextBlock Text="피크 병합 반경" VerticalAlignment="Center"/><TextBox x:Name="MergeRadius" Text="18" Width="46" Margin="6,0,5,0"/><TextBlock Text="px" VerticalAlignment="Center" Margin="0,0,14,0"/>
        <TextBlock Text="평면 허용오차" VerticalAlignment="Center"/><TextBox x:Name="PlaneTolerance" Text="4" Width="42" Margin="6,0,5,0"/><TextBlock Text="mm" VerticalAlignment="Center"/>
        <Button Style="{StaticResource ActionButton}" Content="ROI 전체" Click="ResetRoi_Click" Margin="16,0,0,0"/>
      </StackPanel>
    </Border>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
      <Border Background="Black" CornerRadius="7" ClipToBounds="True"><Grid x:Name="VideoHost" MouseLeftButtonDown="Video_MouseDown" MouseMove="Video_MouseMove" MouseLeftButtonUp="Video_MouseUp" SizeChanged="Video_SizeChanged" Cursor="Cross"><Image x:Name="Heatmap" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/><Canvas x:Name="Overlay" IsHitTestVisible="False"><Rectangle x:Name="RoiBox" Stroke="White" StrokeThickness="2" StrokeDashArray="5,3"/><Canvas x:Name="HoleLayer"/></Canvas><TextBlock x:Name="EmptyLabel" Text="LIVE START 후 검사할 표면의 ROI를 지정하세요" Foreground="#7D8B9D" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border>
      <Border Grid.Column="2" Background="#151B24" CornerRadius="7" Padding="12">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="3*"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/></Grid.RowDefinitions>
          <TextBlock Text="ANCHOR HOLE RESULTS" Foreground="#8FA2B8" FontWeight="Bold"/>
          <Border Grid.Row="1" Background="#10151C" BorderBrush="#344052" BorderThickness="1" Margin="0,10" Padding="10"><TextBlock x:Name="StateText" Text="IDLE"/></Border>
          <DataGrid x:Name="ResultGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="#10151C" Foreground="White" RowBackground="#10151C" AlternatingRowBackground="#18202B" ColumnHeaderStyle="{StaticResource GridHeader}"><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Id}" Width="38"/><DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}" Width="90"/><DataGridTextColumn Header="Depth" Binding="{Binding Depth}" Width="85"/><DataGridTextColumn Header="X" Binding="{Binding X}" Width="*"/><DataGridTextColumn Header="Y" Binding="{Binding Y}" Width="*"/><DataGridTextColumn Header="Z" Binding="{Binding Z}" Width="*"/></DataGrid.Columns></DataGrid>
          <Grid Grid.Row="3" Margin="0,12,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="NOISE PROFILE · HOLE #" Foreground="#8FA2B8" FontWeight="Bold" VerticalAlignment="Center"/><ComboBox x:Name="HoleSelector" Grid.Column="1" Margin="8,0,0,0" Foreground="Black" Background="White" SelectionChanged="HoleSelector_Changed"/><TextBlock x:Name="GraphSummary" Grid.Column="2" Margin="10,0,0,0" Foreground="#AAB7C6" VerticalAlignment="Center" Text="Select a detected hole"/></Grid>
          <Border Grid.Row="4" Background="#0A0E13" BorderBrush="#344052" BorderThickness="1" CornerRadius="4" ClipToBounds="True"><Canvas x:Name="NoiseGraph" SizeChanged="NoiseGraph_SizeChanged"/></Border>
        </Grid>
      </Border>
    </Grid>
    <TextBlock x:Name="Footer" Grid.Row="2" Margin="4,9,0,0" Foreground="#8291A3" Text="Ready"/>
  </Grid>
</Window>
